# ────────────────────────────────────────────────
# Cognito Backend — Environment Variables
# ────────────────────────────────────────────────

# Google Gemini — FREE at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas — paste your full connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/cognito?retryWrites=true&w=majority

# Server
PORT=3001

